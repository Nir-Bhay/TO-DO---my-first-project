# ==============================================================================
# Velora Studio — Environment Configuration (.env.example)
# ==============================================================================

# Local HTTP Server Port (defaults to 3080)
PORT=3080

# Official Meta Graph & Instagram Messenger API OAuth Credentials
# Obtain at: https://developers.facebook.com/apps/ (Business App -> Instagram API)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=velora_webhook_secret_2026
META_OAUTH_REDIRECT_URI=http://localhost:3080/api/meta/oauth/callback

# Required Instagram OAuth Scopes in Meta App Dashboard:
#   - instagram_business_basic
#   - instagram_business_content_publish
#   - instagram_business_manage_comments
#   - instagram_business_manage_messages
#   - instagram_manage_insights
